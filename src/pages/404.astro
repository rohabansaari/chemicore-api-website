---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you are looking for does not exist." page="none">
  <section class="ph navy" style="min-height:70vh">
    <div class="lat"><svg><rect width="100%" height="100%" fill="url(#hx)" /></svg></div>
    <div class="wrap">
      <div class="crumb fi"><a href="/">Home</a><span>/</span><span>404</span></div>
      <h1 class="split">This page isn’t on the shelf.</h1>
      <p class="lead fi" style="--d:400ms">The link may be old or mistyped. Try the catalogue, or tell us what you’re looking for.</p>
      <div class="fi" style="--d:600ms;display:flex;gap:12px;flex-wrap:wrap"><a class="btn b-white" href="/products/">Browse materials</a><a class="btn b-line" href="/contact/">Contact us</a></div>
    </div>
  </section>
</Base>
