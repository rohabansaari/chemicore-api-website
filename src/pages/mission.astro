---
import Base from '../layouts/Base.astro';
---
<Base title="Our mission" description="Our mission is to give pharmaceutical companies reliable access to high-quality APIs, excipients and packaging at competitive prices." page="mission">
  <section class="ph navy">
    <div class="lat"><svg><rect width="100%" height="100%" fill="url(#hx)"/></svg></div>
    <div class="wrap">
      <div class="crumb fi"><a href="/">Home</a><span>/</span><span>Mission</span></div>
      <h1 class="split">Your API partner in growth.</h1>
      <p class="lead fi" style="--d:500ms">Reliable sourcing for a stronger pharmaceutical future.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap"><p class="scrub" id="scrub">Our mission is to give pharmaceutical companies [reliable access] to high-quality raw materials, APIs, excipients and packaging at [competitive prices], so they can keep production running in a demanding market.</p></div>
  </section>
  <section class="sec ice">
    <div class="wrap">
      <div class="sh"><h2 data-r>What the mission means in practice.</h2></div>
      <div class="vals">
        <div class="v" data-r><span class="big">Access</span><h3>Consistent quality and value</h3><p>We help clients maintain efficient production by delivering consistent quality and value, even when the market tightens.</p></div>
        <div class="v" data-r style="--rd:120ms"><span class="big">Assurance</span><h3>Recognised manufacturers only</h3><p>Every material comes from a recognised producer, with documentation aligned with DRAP and pharmaceutical regulatory standards.</p></div>
        <div class="v" data-r style="--rd:240ms"><span class="big">Growth</span><h3>Stronger sourcing networks</h3><p>Through efficient procurement and long-term partnerships, we give companies room to grow, innovate and compete.</p></div>
      </div>
    </div>
  </section>
  <section class="sec navy">
    <div class="wrap" style="display:grid;gap:clamp(40px,6vw,64px)">
      <div class="sh" style="margin:0"><h2 data-r>Precision sourcing, powered by trust.</h2><p class="muted" data-r style="--rd:100ms">What every client can hold us to.</p></div>
      <div class="commit">
        <div data-r><b>GMP-certified sources</b><span>Materials only from qualified, audited manufacturers.</span></div>
        <div data-r style="--rd:80ms"><b>Documents before dispatch</b><span>Your QA team sees the full file before shipping.</span></div>
        <div data-r style="--rd:160ms"><b>Updates at every milestone</b><span>Loading, transit, arrival and clearance.</span></div>
        <div data-r style="--rd:240ms"><b>Support after delivery</b><span>Queries and reorders handled by the same team.</span></div>
      </div>
      <div data-r style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn b-white mag" href="https://wa.me/923260833256" target="_blank" rel="noopener">Chat on WhatsApp <svg class="ar"><use href="#arr"/></svg></a><a class="btn b-line mag" href="/contact/">Contact us</a></div>
    </div>
  </section>
</Base>
