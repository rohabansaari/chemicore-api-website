---
interface Props { crumb: string; title: string; lead: string; leadDelay?: number }
const { crumb, title, lead, leadDelay = 500 } = Astro.props;
---
<section class="ph navy">
  <div class="lat"><svg><rect width="100%" height="100%" fill="url(#hx)" /></svg></div>
  <div class="wrap">
    <div class="crumb fi"><a href="/">Home</a><span>/</span><span>{crumb}</span></div>
    <h1 class="split">{title}</h1>
    <p class="lead fi" style={`--d:${leadDelay}ms`}><slot name="lead">{lead}</slot></p>
  </div>
</section>
