---
import '../styles/global.css';
import Sprites from '../components/Sprites.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, type PageKey } from '../data/site';

interface Props { title: string; description: string; page: PageKey }
const { title, description, page } = Astro.props;
const fullTitle = page === 'home' ? `${site.name} · Pharmaceutical indenting house, Lahore` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: Astro.site?.toString(),
  email: site.email,
  telephone: site.phoneRaw,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Office No. 1107, 11th Floor, Grand Square Mall, Gulberg III',
    addressLocality: 'Lahore',
    addressCountry: 'PK',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:image" content={new URL('/brand/logo.png', Astro.site)} />
    <meta name="theme-color" content="#002156" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800;900&family=Figtree:wght@400;500;600;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline>
      // Cover the page before first paint when arriving via an animated page change.
      try { var w = sessionStorage.getItem('cc-wipe'); if (w) { document.documentElement.classList.add('wiping'); document.documentElement.dataset.wipe = w; } } catch (e) {}
    </script>
  </head>
  <body data-page={page}>
    <Sprites />
    <div class="prog" id="prog"></div>
    <div class="wipe w2" id="wipe2" aria-hidden="true" style="--dli:0s;--dlo:.14s"></div>
    <div class="wipe" id="wipe" aria-hidden="true" style="--dli:.09s;--dlo:0s"><div class="wt"><img src="/brand/mark-white.png" alt="" width="216" height="247" /><span id="wt"></span></div></div>
    <Header page={page} />
    <main id="main"><slot /></main>
    <div class="tray" id="tray" aria-live="polite"><span id="trayt"></span><a class="btn b-white sm" href="/contact/">Review <svg class="ar"><use href="#arr" /></svg></a></div>
    <a class="wa" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><span class="tip">Chat with the sourcing team</span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3z"/></svg></a>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
